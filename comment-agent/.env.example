# Copy this file to .env and fill it in. Never commit .env.

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# From developers.facebook.com -> your app -> Instagram -> API setup with Instagram login
IG_APP_SECRET=

# Make up any long random phrase. Paste the same phrase into the webhook setup in Meta.
WEBHOOK_VERIFY_TOKEN=

# Password for your dashboard (username can be anything)
DASHBOARD_PASSWORD=

# false = every reply waits for your OK (start here). true = simple replies post by themselves.
AUTO_POST=false

# Seconds to wait between replies
MIN_SECONDS_BETWEEN_REPLIES=45
